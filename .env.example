# Meta Model API (https://dev.meta.ai) - required
MODEL_API_KEY=your-meta-api-key-here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Cost guards
MAX_TOKENS=6000
MAX_AGENT_STEPS=8

# Baseten hackathon key (Muse Spark Open, open weights); leave blank to disable
BASETEN_API_KEY=
OPEN_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL=meta-models/muse-spark-open-1026
# AGENT_BACKEND=open runs the whole agent on open-weight Muse Spark Open
AGENT_BACKEND=spark
# Modal uses `modal token new`, no key needed here
