# Meta Model API (https://dev.meta.ai) - required
MODEL_API_KEY=your-meta-api-key-here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Cost guards
MAX_TOKENS=6000
MAX_AGENT_STEPS=8

# Later (leave blank for now)
# Free key from build.nvidia.com (serves open-weight Muse Glimmer 30B); leave blank to disable
GLIMMER_API_KEY=
GLIMMER_BASE_URL=https://integrate.api.nvidia.com/v1
GLIMMER_MODEL=meta/muse-glimmer-30b
# AGENT_BACKEND=glimmer runs the whole agent on Glimmer
AGENT_BACKEND=spark
BASETEN_API_KEY=
# Modal uses `modal token new`, no key needed here
